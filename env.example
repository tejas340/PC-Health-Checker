# PC Health Checker – Environment Configuration
# ------------------------------------------------
# Copy this file to .env and fill in your own values.
# Never commit your .env file to version control.

# Flask secret key – used to sign session cookies.
# REQUIRED: Change this to a long, random string in production.
FLASK_SECRET_KEY=change-this-secret-key

# Set to True only during development.
# Always use False (or omit) in production.
FLASK_DEBUG=False
